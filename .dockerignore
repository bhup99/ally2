# .dockerignore — keep the build context small and secret-free.

# dependencies (reinstalled inside the image)
node_modules/
client/node_modules/
server/node_modules/

# build outputs (rebuilt inside the image)
client/dist/
server/dist/

# OCR model cache (baked into the image at build time instead)
eng.traineddata
server/eng.traineddata
*.traineddata.gz

# version control
.git/
.gitignore

# local env / logs / OS noise
.env
.env.*
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/
